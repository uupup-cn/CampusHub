[Unit]
Description=CampusHub Frontend (Next.js)
After=network.target chb-backend.service
Wants=chb-backend.service

[Service]
Type=simple
WorkingDirectory=/opt/campushub/chb-frontend
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=NEXT_PUBLIC_API_BASE=http://112.213.106.104/api
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target